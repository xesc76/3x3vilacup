# Copia aquest fitxer a .env.local i omple els valors.
# Els trobaràs a: Supabase Dashboard > Project Settings > API
#
# Les dues claus són PÚBLIQUES (van al navegador). El que protegeix les dades
# són les polítiques RLS, no aquestes claus. NO posis mai aquí la service_role.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9....

# URL pública del web desplegat. Només s'utilitza per generar els QR.
NEXT_PUBLIC_SITE_URL=https://vilacup.vercel.app
